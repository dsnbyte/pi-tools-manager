{
  "name": "@dsnbyte/pi-tools-manager",
  "version": "0.1.0",
  "description": "Pi extension to inspect, search, and toggle installed tools via an interactive TUI",
  "type": "module",
  "author": "dsnbyte",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsnbyte/pi-tools-manager.git"
  },
  "bugs": {
    "url": "https://github.com/dsnbyte/pi-tools-manager/issues"
  },
  "homepage": "https://github.com/dsnbyte/pi-tools-manager#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "tools",
    "tool-manager",
    "tui"
