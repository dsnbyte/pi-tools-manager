{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "noUnusedLocals": true,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "extensions/**/*.ts"
  ]
}